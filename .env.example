# ─── Client-side (Vite injects these into the bundle) ─────────────────────

# Supabase (required for cloud sync + handoff)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...your-anon-key

# Optional: override base path (e.g. for GitHub Pages: /Toranot/)
# VITE_BASE_PATH=/

# ─── Server-side (Netlify env vars — never exposed to client) ─────────────

# Claude Vision API (required for camera OCR + AI clinical reasoning)
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini API (optional, alternative AI backend)
# GEMINI_API_KEY=AIza...

# Override default AI models (optional)
# CLAUDE_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-2.5-flash

# Legacy auth fallback for local dev (optional — Supabase JWT preferred)
# API_SECRET=your-shared-secret

# Rate limiting (optional — requires Upstash Redis)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AX...
